[Unit]
Description=Chatstronomy astronomical observation chat updater
Documentation=https://github.com/theatrus/chatstronomy
After=network-online.target
Wants=network-online.target
# Don't start the daemon until an operator has provided a config.
ConditionFileNotEmpty=/etc/chatstronomy/config.json

[Service]
Type=exec
User=chatstronomy
Group=chatstronomy
EnvironmentFile=/etc/chatstronomy/chatstronomy.conf
# chat-updater polls every configured telescope and fans notifications out to
# the configured chat services. Poll interval + any extra flags come from the
# EnvironmentFile above.
ExecStart=/usr/bin/chatstronomy --config /etc/chatstronomy/config.json \
    chat-updater --interval ${CHATSTRONOMY_INTERVAL} $CHATSTRONOMY_EXTRA_ARGS
Restart=on-failure
RestartSec=5

# Sandboxing. The daemon only needs to read its config and reach the network
# (NINA API + Discord/Matrix); it keeps no on-disk state.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/chatstronomy
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Logging.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatstronomy

[Install]
WantedBy=multi-user.target
